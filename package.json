{
  "name": "myth-guard",
  "version": "1.0.1",
  "description": "A local virtual tabletop for Dungeons & Dragons: the GM runs it on one computer, players join from their phones over Wi-Fi.",
  "author": "Myth Guard",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:player-native": "vite build --config vite.player-native.config.js && cap sync android",
    "package:win": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --dir",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "preview": "vite preview",
    "icons": "node scripts/build-icons.mjs",
    "test": "node --test",
    "check:browser": "node scripts/check-player-browser.mjs",
    "accept": "node scripts/accept-net.mjs",
    "check:eol": "node scripts/check-eol.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@noble/hashes": "^2.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "konva": "^9.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.0.0",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "use-image": "^1.1.1",
    "vite": "^5.4.10"
  }
}
